# ==============================================================================
# Environment Configuration - Lagangilang 360° Road and Trail System
# ==============================================================================

# Option 1A: Simple Local PostgreSQL connection string
# Replace YOUR_PASSWORD with your pgAdmin 4 master password
LOCAL_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/lagangilang_db"

# Option 1B: Discrete connection settings (Handy if your password has special symbols like @ or #)
# PGUSER=postgres
# PGPASSWORD=YOUR_PASSWORD
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=lagangilang_db

# Option 2: Neon Cloud PostgreSQL (for live cloud deployment / Vercel)
# Get your connection string from https://neon.tech
VITE_NEON_DATABASE_URL=""

# Backend API Port
PORT=3001
